# Serves the built static SPA on :80 with history-API fallback.
# Build first: `bun run build` → ./dist
:80 {
	root * /srv
	encode gzip zstd

	try_files {path} /index.html
	file_server

	# Bun produces chunk-*.css and chunk-*.js — long-cache these.
	@assets path /chunk-*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Runtime JSON files — never cache (fetched on each page load).
	@data path *.json
	header @data Cache-Control "no-cache"
}
